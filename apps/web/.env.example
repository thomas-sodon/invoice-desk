# Web app (apps/web). Copy to apps/web/.env.local.
# 1 = run entirely on bundled fixture data (no backend needed). Default when NEXT_PUBLIC_API_BASE is unset.
NEXT_PUBLIC_API_MOCK=1
# Base URL of the FastAPI gateway, without /api/v1, e.g. http://localhost:8000
NEXT_PUBLIC_API_BASE=
# Offline/dev auth: staff email sent as X-Dev-User (accepted only when INVOICEDESK_MODE=offline)
NEXT_PUBLIC_DEV_USER=dana.clerk@maplerow.example
# Cloudflare Turnstile site key for the try-it page. 1x00000000000000000000AA is Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
