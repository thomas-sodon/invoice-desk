# Copy to .env (never commit .env). Offline mode needs none of the keys below.
INVOICEDESK_MODE=offline            # offline | live  (offline = fakes/replay, never calls paid APIs)
INVOICEDESK_TENANT=maple_row
DATABASE_URL=postgresql://invoicedesk:invoicedesk@localhost:54322/invoicedesk
STORAGE_BACKEND=local               # local | memory | supabase
STORAGE_LOCAL_DIR=./var/storage
LLM_REPLAY_DIR=./data/replay
API_BASE_URL=http://localhost:8000
WORKER_CONCURRENCY=8

# Claude (live mode only)
ANTHROPIC_API_KEY=

# Supabase (Storage, Realtime, Auth)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# QuickBooks Online: SANDBOX ONLY, never a production realm
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REALM_ID=
QBO_REFRESH_TOKEN=
QBO_ENVIRONMENT=sandbox

# Langfuse (OTel GenAI spans)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Public try-it page
TURNSTILE_SECRET_KEY=
SESSION_SIGNING_SECRET=change-me
INGEST_WEBHOOK_SECRET=change-me
PUBLIC_DAILY_SPEND_CAP_USD=3.00

# Try-it limits and spend reserve (defaults shown)
TRYIT_UPLOADS_PER_SESSION=3
TRYIT_UPLOADS_PER_IP_PER_DAY=10
TRYIT_SESSIONS_PER_IP_PER_DAY=5
TRYIT_DEMO_RUNS_PER_IP_PER_DAY=5
TRYIT_COST_RESERVE_USD=0.07          # cap counts as reached once spend + reserve > the daily cap
TRYIT_MAX_TIER=sonnet
TRYIT_SESSION_TTL_S=86400

# API gateway
# API_PIPELINE_MODE=embedded         # embedded | worker (unset: embedded offline, worker live)
API_EMBEDDED_WORKER=true
API_EMBEDDED_CONCURRENCY=4
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_STORAGE_BUCKET=invoices
COOKIE_SECURE=false                 # true behind HTTPS
TRUST_FORWARDED_FOR=false           # never true on Fly.io (client-controlled left-most hop)
# CLIENT_IP_HEADER=Fly-Client-IP    # proxy-set client IP header (Fly.io); unset locally
WEB_ORIGINS=http://localhost:3000
SSE_KEEPALIVE_S=15
REPORT_CARD_DIR=./docs/report-card
# NOTE: INVOICEDESK_MODE=offline accepts the X-Dev-User header (staff impersonation for local
# dev). A public deployment must run INVOICEDESK_MODE=live.

# Agent facade (/api/v1/agent/*): service JWTs minted by the MCP server, shared secret
# AGENT_JWT_SECRET=<32+ random characters, shared by the API and the MCP server>
AGENT_JWT_AUDIENCE=invoicedesk-api

# Remote MCP server (make mcp; offline dev auth: make mcp-devtoken)
MCP_HOST=127.0.0.1
MCP_PORT=8100
MCP_RESOURCE_URL=http://localhost:8100/mcp
MCP_API_BASE_URL=http://localhost:8000/api/v1
MCP_AUTH_ISSUER=                    # hosted OAuth/CIMD issuer (live); dev issuer from devtoken
MCP_AUTH_JWKS_URL=                  # optional; defaults to <issuer>/oauth2/jwks
MCP_AUTH_JWKS_FILE=                 # offline only (make mcp-devtoken writes var/mcp-dev/jwks.json)
MCP_REQUEST_STATE_KEYS=             # required with more than one replica (sealed MRTR state)
MCP_ALLOWED_HOSTS=                  # comma-separated Host allow-list, e.g. localhost:8100
MCP_ALLOWED_ORIGINS=
MCP_JSON_RESPONSE=false
MCP_TOOLS_LIST_TTL_MS=300000

# Worker / pipeline
INVOICEDESK_LLM_FALLBACK=           # offline replay fallback module:factory; unset = the data
                                    # package's gold-backed oracle; "none" = no fallback
QBO_EXPENSE_ACCOUNT_REF=7           # QBO expense account id for bill lines (no tenant mapping yet)
INVOICEDESK_CALIBRATOR=             # fitted calibrator JSON (dev split only); unset = heuristic-v1

# n8n (vendor follow-ups out through Mailpit in dev; e-mail ingest in)
N8N_FOLLOWUP_WEBHOOK_URL=           # compose: http://n8n:5678/webhook/invoicedesk-followup
FOLLOWUP_FROM_ADDRESS=ap@maplerow.example
FOLLOWUP_ALLOWED_RECIPIENT_DOMAINS= # optional comma-separated allow-list

# Optional OCR / eval config G (live mode only)
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# Evals
INVOICEDESK_EVAL_LOG=WARNING        # eval runner log level

# Tests: point at an existing server instead of starting a throwaway cluster
# INVOICEDESK_TEST_DSN=postgresql://postgres@localhost:5432/postgres
